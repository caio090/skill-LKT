{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Fluxo de trabalho",
  "description": "Sequência operacional de tarefas internas. Ver knowledge/projetos/ONTOLOGIA_PROCESSOS_FUNIS_PIPELINES.md.",
  "type": "object",
  "required": [
    "id",
    "workspace_id",
    "nome",
    "tarefas",
    "status"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "workspace_id": {
      "type": "string"
    },
    "nome": {
      "type": "string"
    },
    "tarefas": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "nome",
          "responsavel_papel",
          "status"
        ],
        "properties": {
          "nome": {
            "type": "string"
          },
          "responsavel_papel": {
            "type": "string"
          },
          "aprovador_papel": {
            "type": [
              "string",
              "null"
            ]
          },
          "dependencias": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "arquivo_gerado": {
            "type": [
              "string",
              "null"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "a-fazer",
              "em-andamento",
              "em-aprovacao",
              "concluida",
              "bloqueada"
            ]
          }
        }
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "ativo",
        "pausado",
        "concluido"
      ]
    }
  }
}
