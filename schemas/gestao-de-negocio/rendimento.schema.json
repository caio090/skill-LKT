{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Rendimento",
  "description": "Usado por ficha-tecnica e rendimento-e-desperdicio.",
  "type": "object",
  "properties": {
    "ingrediente_id": { "type": "string" },
    "peso_bruto": { "type": "number" },
    "peso_liquido": { "type": "number" },
    "peso_final_preparado": { "type": ["number", "null"] },
    "rendimento_aproveitavel": { "type": "number", "description": "peso_liquido ÷ peso_bruto" },
    "rendimento_coccao": { "type": ["number", "null"], "description": "peso_final_preparado ÷ peso_liquido" },
    "percentual_perda": { "type": "number" },
    "data_medicao": { "type": "string", "format": "date" },
    "fonte": { "type": "string" }
  },
  "required": ["ingrediente_id", "peso_bruto", "peso_liquido", "rendimento_aproveitavel", "percentual_perda", "fonte"]
}
