{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Conjunto de níveis",
  "description": "Uma escala aplicada a uma dimensão. Ver knowledge/niveis/NIVEIS_E_DIMENSOES.md.",
  "type": "object",
  "required": [
    "id",
    "slug",
    "nome",
    "dimensao",
    "niveis",
    "status"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "slug": {
      "type": "string"
    },
    "nome": {
      "type": "string"
    },
    "descricao": {
      "type": [
        "string",
        "null"
      ]
    },
    "dimensao": {
      "type": "string",
      "description": "Ex.: maturidade-digital, maturidade-financeira, complexidade-do-projeto — livre, catalogado em catalogo/niveis/."
    },
    "area": {
      "type": [
        "string",
        "null"
      ]
    },
    "versoes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "niveis": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "IDs de level-definition, em ordem."
    },
    "status": {
      "type": "string",
      "enum": [
        "rascunho",
        "ativo",
        "descontinuado"
      ]
    },
    "aplicabilidade": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Tipos de projeto/workspace onde esta dimensão costuma se aplicar."
    },
    "criado_em": {
      "type": "string",
      "format": "date-time"
    },
    "atualizado_em": {
      "type": "string",
      "format": "date-time"
    }
  }
}
